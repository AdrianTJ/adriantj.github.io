---
layout: page
---
{{ content }}

{% if page.collection %}
  {% assign collection = site[page.collection] %}
  {% for item in collection reversed %}
    {% assign current_year = item.date | date: '%Y' %}
    {% if current_year != year %}
      {% unless forloop.first %}</ul>{% endunless %}
      <h2 class="book-year" id="y{{ current_year }}">
        <a href="{{ current_year | prepend: '/books/' | relative_url }}">{{ current_year }}</a>
      </h2>
      <ul class="book-grid">
        {% assign year = current_year %}
    {% endif %}
    <li>
      <a class="book-entry" href="{{ item.url | relative_url }}">
        {% if item.cover %}
          <img
            alt="{{ item.title | escape }} cover"
            src="{{ item.cover | prepend: page.covers | relative_url }}"
            loading="lazy"
            width="150"
            height="220"
          >
        {% elsif item.olid %}
          <img
            alt="{{ item.title | escape }} cover"
            src="https://covers.openlibrary.org/b/olid/{{ item.olid }}-L.jpg?default=false"
            loading="lazy"
            width="150"
            height="220"
          >
        {% elsif item.isbn %}
          <img
            alt="{{ item.title | escape }} cover"
            src="https://covers.openlibrary.org/b/isbn/{{ item.isbn }}-L.jpg?default=false"
            loading="lazy"
            width="150"
            height="220"
          >
        {% endif %}
        <span class="book-title">{{ item.title }}</span>
        {% if item.status -%}
          <span class="book-status">{{ item.status | downcase }}</span>
        {%- endif %}
      </a>
    </li>
    {% if forloop.last %}</ul>{% endif %}
  {% endfor %}
{% endif %}
